---
// SHARED LAYOUT for every page: head (SEO, share preview, schema), the logo
// symbol, nav, mobile menu, footer, sticky mobile bar and the enquiry modal.
// Real-world values (numbers, emails, address) come from src/scripts/config.js.
import '../styles/global.css';
import '../styles/pages.css';
import { SITE, BASE, ROBOTS } from '../scripts/config.js';
import WaIcon from '../components/WaIcon.astro';

const {
  title,
  description,
  path = '',          // '' for home, 'about/' for /about/
  page = 'home',      // marks the active nav link and tags enquiries
  schema = [],        // extra JSON-LD nodes (BreadcrumbList, FAQPage)
  ogImage
} = Astro.props;

const site = Astro.site ? String(Astro.site).replace(/\/$/, '') : '';
const url = site + BASE + path;
const og = ogImage || site + BASE + 'og.jpg';
const wa = 'https://wa.me/' + SITE.whatsapp;
const year = new Date().getFullYear();

const nav = [
  { href: BASE, label: 'Home', key: 'home' },
  { href: BASE + 'sri-lanka-tours/', label: 'Sri Lanka Tours', key: 'tours' },
  { href: BASE + 'holidays-abroad/', label: 'Holidays Abroad', key: 'holidays' },
  { href: BASE + 'about/', label: 'About', key: 'about' },
  { href: BASE + 'contact/', label: 'Contact', key: 'contact' }
];

const org = {
  '@type': 'TravelAgency',
  '@id': site + BASE + '#org',
  name: SITE.name,
  url: site + BASE,
  logo: site + BASE + 'images/cct-logo.png',
  image: og,
  foundingDate: SITE.founded,
  telephone: SITE.phones[0],
  email: SITE.emails.general,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressCountry: 'LK'
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: SITE.phones[0],
    url: wa
  },
  areaServed: ['Sri Lanka', 'Worldwide'],
  sameAs: [SITE.social.facebook, SITE.social.instagram].filter(Boolean)
};
const website = {
  '@type': 'WebSite',
  '@id': site + BASE + '#website',
  url: site + BASE,
  name: SITE.name,
  publisher: { '@id': site + BASE + '#org' }
};
const graph = { '@context': 'https://schema.org', '@graph': [org, website, ...schema] };
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta name="robots" content={ROBOTS}>
<meta name="theme-color" content="#008292">
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href={BASE + 'images/cct-logo-180.png'} type="image/png">
<link rel="apple-touch-icon" href={BASE + 'images/cct-logo-180.png'}>
<!-- Search Console verification: paste the content value here at launch -->
<!-- <meta name="google-site-verification" content=""> -->
<!-- GA4: paste the gtag snippet here at launch -->
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body data-page={page}>

<!-- Logo: the client's REAL mark, lifted from their own lockup and cut out
     with a transparent background. Never redraw a client logo. -->

<a class="skip" href="#main">Skip to content</a>
<div id="scrollProgress"></div>

<nav class="nav" id="nav">
  <div class="container nav-inner">
    <a href={BASE} class="nav-logo" aria-label="Ceylon Carriers Travels home">
      <img class="logo-mark" src={BASE + 'images/cct-logo.png'} alt="Ceylon Carriers Travels" width="256" height="256">
      <span>Ceylon Carriers<small>TRAVELS · EST 1973</small></span>
    </a>
    <ul class="nav-links">
      {nav.map(n => <li><a href={n.href} class:list={[{ on: n.key === page }]} aria-current={n.key === page ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
    <a class="btn btn-gold nav-cta" href={BASE + 'contact/'}>Contact Us</a>
    <button class="nav-burger" id="burger" aria-label="Open menu"><span></span><span></span><span></span></button>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <button class="close-x" id="menuClose" aria-label="Close menu">✕</button>
  {nav.map(n => <a href={n.href}>{n.label}</a>)}
  <div class="menu-foot">
    <a class="btn btn-gold" href={BASE + 'contact/'}>Contact Us</a>
    <a class="btn btn-glass" data-wa-link href={wa} target="_blank" rel="noopener"><WaIcon /> WhatsApp Us</a>
  </div>
</div>

<main id="main">
  <slot />
</main>

<footer class="footer" id="contact">
  <!-- No background photograph here on purpose. The closing band above already
       carries one and fades into this colour, so the two read as a single dark
       section rather than two stacked images. -->
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="f-brand">
          <img class="logo-mark" src={BASE + 'images/cct-logo.png'} alt="Ceylon Carriers Travels" width="256" height="256">
          <div>Ceylon Carriers<small>TRAVELS · EST 1973</small></div>
        </div>
        <p class="f-about">Sri Lanka's trusted travel house since 1973, crafting inbound island journeys and worldwide holidays for Sri Lankan travellers.</p>
        <div class="f-social">
          {SITE.social.facebook && <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.49h-2.8V24C19.62 23.09 24 18.1 24 12.07z"/></svg></a>}
          {SITE.social.instagram && <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23a3.7 3.7 0 0 1-.9 1.38c-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.9 5.9 0 0 0-2.13 1.38A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.8.72 1.47 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.15A4 4 0 1 1 16 12a4 4 0 0 1-4 3.99zm7.85-10.4a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44z"/></svg></a>}
          {SITE.social.tiktok && <a href={SITE.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg></a>}
        </div>
      </div>
      <div>
        <h5>Explore</h5>
        <ul>
          <li><a href={BASE + 'sri-lanka-tours/'}>Sri Lanka Tours</a></li>
          <li><a href={BASE + 'holidays-abroad/'}>Holidays Abroad</a></li>
          <li><a href={BASE + 'about/'}>About Us</a></li>
          <li><a href={BASE + 'contact/'}>Contact</a></li>
        </ul>
      </div>
      <div>
        <h5>Tours</h5>
        <ul>
          <li><a href={BASE + 'sri-lanka-tours/#tours'}>Sri Lanka Inbound</a></li>
          <li><a href={BASE + 'holidays-abroad/#velankanni'}>Group Pilgrimages</a></li>
          <li><a href={BASE + 'holidays-abroad/#portugal'}>Europe Escorted</a></li>
          <li><a href={BASE + 'sri-lanka-tours/#honeymoon'}>Honeymoon Packages</a></li>
        </ul>
      </div>
      <div>
        <h5>Get in touch</h5>
        <ul class="f-contact">
          <li><svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>{SITE.address.street},<br>{SITE.address.city}, {SITE.address.country}</span></li>
          <li><svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><a href={'tel:' + SITE.phones[0].replace(/\s/g, '')}>{SITE.phones[0]}</a></li>
          <li><svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg><a href={'mailto:' + SITE.emails.general}>{SITE.emails.general}</a></li>
          <li><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><a data-wa-link href={wa} target="_blank" rel="noopener">Chat on WhatsApp</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Ceylon Carriers Travels. All rights reserved.</span>
      <span>Established 1973 · Crafting journeys for over 50 years</span>
    </div>
  </div>
</footer>

<div class="sticky-bar" id="stickyBar">
  <a class="btn sticky-wa" data-wa-link href={wa} target="_blank" rel="noopener"><WaIcon /> WhatsApp</a>
  <button class="btn btn-teal" data-open-modal>Plan My Trip</button>
</div>

<div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal">
    <button class="modal-close" id="modalClose" aria-label="Close">✕</button>
    <div class="m-head">
      <h3 id="modalTitle">Plan My Trip</h3>
      <p>Four quick steps, then we take over on WhatsApp.</p>
    </div>
    <div class="m-progress"><div class="bar" id="mBar"></div></div>

    <div class="m-step on" data-step="1">
      <div class="m-steplabel">Step 1 of 4</div>
      <div class="m-q">Which way are you travelling?</div>
      <div class="choice-grid">
        <button class="choice" data-choice="scope" data-val="Inbound">Visiting Sri Lanka<small>International travellers coming in</small></button>
        <button class="choice" data-choice="scope" data-val="Outbound">Travelling Abroad<small>Sri Lankan travellers heading out</small></button>
      </div>
      <div class="m-nav">
        <span></span>
        <button class="btn btn-teal m-next" id="next1" disabled style="opacity:.45">Continue</button>
      </div>
    </div>

    <div class="m-step" data-step="2">
      <div class="m-steplabel">Step 2 of 4</div>
      <div class="m-q">Where would you like to go?</div>
      <div class="chip-wrap" id="destChips"></div>
      <div class="m-nav">
        <button class="m-back" data-back>← Back</button>
        <button class="btn btn-teal m-next" id="next2" disabled style="opacity:.45">Continue</button>
      </div>
    </div>

    <div class="m-step" data-step="3">
      <div class="m-steplabel">Step 3 of 4</div>
      <div class="m-q">Tell us about the trip</div>
      <div class="m-fields">
        <div class="row2">
          <div class="field">
            <label for="fDate">Travel month / dates</label>
            <input type="text" id="fDate" placeholder="e.g. December 2026" autocomplete="off">
          </div>
          <div class="field">
            <label for="fPax">Travellers</label>
            <select id="fPax">
              <option>1</option><option selected>2</option><option>3</option><option>4</option>
              <option>5 to 8</option><option>9 to 15</option><option>16 or more</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label>Trip type</label>
          <div class="chip-wrap">
            <button class="chip" data-choice="type" data-val="Group Tour">Group Tour</button>
            <button class="chip" data-choice="type" data-val="Honeymoon">Honeymoon</button>
            <button class="chip" data-choice="type" data-val="Family Holiday">Family Holiday</button>
            <button class="chip" data-choice="type" data-val="Leisure">Leisure</button>
          </div>
        </div>
      </div>
      <div class="m-nav">
        <button class="m-back" data-back>← Back</button>
        <button class="btn btn-teal m-next" id="next3">Continue</button>
      </div>
    </div>

    <div class="m-step" data-step="4">
      <div class="m-steplabel">Step 4 of 4</div>
      <div class="m-q">Where can we reach you?</div>
      <div class="m-fields">
        <div class="field" id="wrapName">
          <label for="fName">Full name</label>
          <input type="text" id="fName" placeholder="Your name" autocomplete="name">
          <span class="err-msg">Please enter your name</span>
        </div>
        <div class="row2">
          <div class="field" id="wrapPhone">
            <label for="fPhone">Phone / WhatsApp</label>
            <input type="tel" id="fPhone" placeholder="+94 7X XXX XXXX" autocomplete="tel">
            <span class="err-msg">Please enter your phone number</span>
          </div>
          <div class="field" id="wrapEmail">
            <label for="fEmail">Email (optional)</label>
            <input type="email" id="fEmail" placeholder="you@email.com" autocomplete="email">
            <span class="err-msg">That email does not look right</span>
          </div>
        </div>
      </div>
      <div class="m-nav">
        <button class="m-back" data-back>← Back</button>
        <button class="btn btn-teal m-next" id="mSubmit"><WaIcon /> Send via WhatsApp</button>
      </div>
    </div>

    <div class="m-step" data-step="5">
      <div class="m-done">
        <div class="tick"><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg></div>
        <h4>Opening WhatsApp…</h4>
        <p>Your trip details are pre-filled and ready to send. Our specialists will pick it up and reply to you personally.</p>
        <button class="btn btn-outline" id="mDoneClose">Close</button>
      </div>
    </div>
  </div>
</div>

<script>import '../scripts/site.js';</script>
</body>
</html>
